# ─────────────────────────── 数据库 ───────────────────────────
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_JDBC_URL=
POSTGRES_DSN=
# Python LangGraph 持久化专用；留空时 Python 使用内存 checkpointer
AGENT_POSTGRES_DSN=
POSTGRES_USER=
POSTGRES_PASSWORD=
# 已有表的结构迁移需要表属主；不填写时沿用业务数据库账号。
FLYWAY_USER=
FLYWAY_PASSWORD=

# Redis 保留（Spring Session + 记忆热缓存）。Python 侧不用。
REDIS_URL=

# ─────────────────────────── 模型 ───────────────────────────
# BYOK 工具（Platform-Utils/model）会写入下列主配置与 AGENT_MODEL_PROFILES_JSON；
# 默认模型为 OpenCode Zen 的 deepseek-v4.1-flash-free。
AGENT_MODEL_ID=deepseek-v4.1-flash-free
AGENT_MODEL_BASE_URL=https://opencode.ai/inference/v1
AGENT_MODEL_API_KEY=

# 摘要模型: 上下文容量必须 >= 主模型
AGENT_SUMMARIZER_MODEL_ID=
AGENT_SUMMARIZER_BASE_URL=
AGENT_SUMMARIZER_API_KEY=

# 显式指定窗口；
AGENT_CONTEXT_WINDOW=200000
AGENT_MAX_OUTPUT_TOKENS=32000
AGENT_MODEL_TEMPERATURE=1.0
# 可选请求参数 JSON；BYOK 工具写入 {"max_tokens":...}，留空保持旧行为。
AGENT_MODEL_REQUEST_KWARGS_JSON=

# 模型出口二选一：false 明确直连；true 统一走指定的 http(s) 入口。
AGENT_MODEL_PROXY_ENABLED=false
AGENT_MODEL_PROXY_URL=http://127.0.0.1:17897

# 导入模型目录：JSON 数组；留空仅有 default，沿用上面的主配置。凭据/连接只能引用环境变量。
# default 条目只可设置 id/name/provider/efforts；不允许覆盖现有连接或窗口。
# 额外条目必须有 id/name/provider/model/apiKeyEnv/baseUrlEnv/contextWindow；可选 kwargs/proxyUrlEnv/efforts。
# kwargs 严格允许 temperature/max_tokens/top_p/frequency_penalty/presence_penalty/seed/reasoning_effort/extra_body。
# extra_body 仅允许 thinking(type: enabled|disabled，可选 budget_tokens) 与 reasoning_effort。
# efforts 仅放已真实验证的 low/medium/high 映射，如 {"low":{"reasoning_effort":"low"}}；未配置则不支持。
# 示例仅说明格式，不是已接入模型：[{"id":"my-profile","name":"自有模型","provider":"openai-compatible","model":"MODEL_ID","apiKeyEnv":"MY_MODEL_KEY","baseUrlEnv":"MY_MODEL_URL","contextWindow":131072,"kwargs":{"max_tokens":8192},"efforts":{}}]
AGENT_MODEL_PROFILES_JSON=
# 平台独立审查使用的 profile；留空默认 default，不读取执行轮次的模型或自评。
AGENT_REVIEW_MODEL_PROFILE_ID=default
# 导入摘要容量证明：配置不同摘要模型时可显式给窗口，必须 >= 选中主模型窗口。
AGENT_SUMMARIZER_CONTEXT_WINDOW=0

# ───────────── Java 配置；application.yml 用 spring.config.import 加载 ─────────────
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET_NAME=
ALIYUN_OSS_REGION=

# ───────────────────── Python 独占 ─────────────────────
AGENT_DEADLINE_MS=1800000
AGENT_MAX_MODEL_CALLS=60
AGENT_LOG_LEVEL=INFO
# 沙箱实现
# Docker 后端优先于 AGENT_SANDBOX_TYPE；local_shell 可用于本地降级/测试
AGENT_SANDBOX_BACKEND=local_shell
AGENT_SANDBOX_IMAGE=glyahh-sandbox-runtime:24.04
AGENT_SANDBOX_TYPE=local_shell

# ─────────────────────────── 工作区 ───────────────────────────
WORKSPACE_ROOT=

# ─────────────────── Java 侧进程池 ───────────────────
AGENT_POOL_CORE_SIZE=3
AGENT_POOL_MAX_SIZE=5
AGENT_POOL_SHRINK_BELOW=2
AGENT_POOL_SCALE_COOLDOWN_MINUTES=5
AGENT_POOL_ACQUIRE_TIMEOUT_SECONDS=30

# Git 导入凭据密钥文件必须放在仓库/工作区之外；JSON 含 activeKeyId 与 keys。
# 缺失时凭据写入/读取明确失败，不生成默认密钥，不影响文件夹导入。
project-import.credential-key-ring-file=

# Git 读取使用服务端已安装的可执行文件绝对路径；不自动安装。
project-import.git-executable=
# 可选：仅允许显式本机 HTTP 代理；留空走经过公共 DNS 地址核验的直连，不自动换线路。
project-import.git-proxy=
