# ─────────────────────────── 数据库 ───────────────────────────
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_JDBC_URL=
POSTGRES_DSN=
# Python LangGraph 持久化专用；留空时 Python 使用内存 checkpointer
AGENT_POSTGRES_DSN=
POSTGRES_USER=
POSTGRES_PASSWORD=
# 已有表的结构迁移需要表属主；不填写时沿用业务数据库账号。
FLYWAY_USER=
FLYWAY_PASSWORD=

# Redis 保留（Spring Session + 记忆热缓存）。Python 侧不用。
REDIS_URL=

# ─────────────────────────── 模型 ───────────────────────────
AGENT_MODEL_ID=
AGENT_MODEL_BASE_URL=https://api.deepseek.com
AGENT_MODEL_API_KEY=

# 摘要模型: 上下文容量必须 >= 主模型
AGENT_SUMMARIZER_MODEL_ID=
AGENT_SUMMARIZER_BASE_URL=
AGENT_SUMMARIZER_API_KEY=

# 显式指定窗口；
AGENT_CONTEXT_WINDOW=0
AGENT_MAX_OUTPUT_TOKENS=32768
AGENT_MODEL_TEMPERATURE=1.0

# 模型出口二选一：false 明确直连；true 统一走指定的 http(s) 入口。
AGENT_MODEL_PROXY_ENABLED=false
AGENT_MODEL_PROXY_URL=http://127.0.0.1:17897

# ───────────── Java 配置；application.yml 用 spring.config.import 加载 ─────────────
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET_NAME=
ALIYUN_OSS_REGION=

# ───────────────────── Python 独占 ─────────────────────
AGENT_DEADLINE_MS=1800000
AGENT_MAX_MODEL_CALLS=60
AGENT_LOG_LEVEL=INFO
# 沙箱实现
# Docker 后端优先于 AGENT_SANDBOX_TYPE；local_shell 可用于本地降级/测试
AGENT_SANDBOX_BACKEND=local_shell
AGENT_SANDBOX_TYPE=local_shell

# ─────────────────────────── 工作区 ───────────────────────────
WORKSPACE_ROOT=

# ─────────────────── Java 侧进程池 ───────────────────
AGENT_POOL_CORE_SIZE=3
AGENT_POOL_MAX_SIZE=5
AGENT_POOL_SHRINK_BELOW=2
AGENT_POOL_SCALE_COOLDOWN_MINUTES=5
AGENT_POOL_ACQUIRE_TIMEOUT_SECONDS=30
