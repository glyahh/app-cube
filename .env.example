# 复制成 .env 后填真实值。.env 已被 .gitignore 忽略，不会入库。
#
# Java 和 Python 读同一份，避免两边配置漂移：
#   Java   走 spring.config.import: optional:file:./.env[.properties]
#   Python 走 agent/env_utils.py
# 语义一致 —— 已存在的非空环境变量优先于本文件。

# ─────────────────────────── 数据库 ───────────────────────────
# PostgreSQL。业务表在 biz schema（Java / Flyway 独占），
# LangGraph 的 checkpoint 表在 langgraph schema（框架自建）。
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gly_ai_generate_code
POSTGRES_JDBC_URL=jdbc:postgresql://localhost:5432/gly_ai_generate_code?currentSchema=biz
POSTGRES_DSN=postgresql://glyahh_agent:changeme@localhost:5432/gly_ai_generate_code?options=-csearch_path%3Dlanggraph
POSTGRES_USER=glyahh_biz
POSTGRES_PASSWORD=changeme

# Redis 保留（Spring Session + 记忆热缓存）。Python 侧不用。
REDIS_URL=redis://localhost:6379/0

# ─────────────────────────── 模型 ───────────────────────────
# Python 侧读这三个。Java 侧 Phase 1 之后不再需要模型密钥（调用都归 Python）。
# 窗口不要写在这里 —— 走 agent/core/model_window.py 的动态解析。
AGENT_MODEL_ID=deepseek-v4-flash
AGENT_MODEL_BASE_URL=https://api.deepseek.com
AGENT_MODEL_API_KEY=
# 摘要模型。设计要求：上下文容量必须 >= 主模型，否则压缩会「无摘要丢弃」中间段。
# 留空表示复用主模型。
AGENT_SUMMARIZER_MODEL_ID=
AGENT_SUMMARIZER_BASE_URL=
AGENT_SUMMARIZER_API_KEY=
# 显式指定窗口；留 0 走动态解析（配置 > /models 探测 > 内置表 > 保守默认）
AGENT_CONTEXT_WINDOW=0
AGENT_MAX_OUTPUT_TOKENS=32768
AGENT_MODEL_TEMPERATURE=1.0
# 模型请求是否走系统代理。默认 false（直连）。
# httpx 默认读 Windows 注册表里的系统代理，抓包/科学上网工具开了全局代理时，
# 到国内模型端点的请求会被一起截走，报错只有 "Connection error." 一句，
# 看不出跟代理有关。除非模型端点确实需要代理才能访问，否则保持 false。
AGENT_MODEL_USE_SYSTEM_PROXY=false

# ───────────── Java 读（Python 不读）；application.yml 用 spring.config.import 加载 ─────────────
# 这五个键必须填全：OSS 客户端在 Spring 启动时构造，凭证无效会让应用直接起不来，
# 不是静默降级 —— 已验证（endpoint 置空时抛 URISyntaxException 并中断启动）。
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET_NAME=
ALIYUN_OSS_REGION=cn-hangzhou

# ───────────────────── Python 独占（Java 不读） ─────────────────────
AGENT_DEADLINE_MS=600000
AGENT_MAX_MODEL_CALLS=60
AGENT_LOG_LEVEL=INFO
# 沙箱实现。local_shell = 本机进程（Phase 0-2）；docker = 容器（Phase 3）
AGENT_SANDBOX_TYPE=local_shell

# ─────────────────────────── 共建 ───────────────────────────
# 生成产物根目录。Java 是路径真相源，Python 只接收下发值，
# 这里的默认值仅用于两边都没配时的兜底。
WORKSPACE_ROOT=

# ─────────────────── Java 侧进程池（阶段 0 的伸缩策略） ───────────────────
AGENT_POOL_CORE_SIZE=3
AGENT_POOL_MAX_SIZE=5
AGENT_POOL_SHRINK_BELOW=2
AGENT_POOL_SCALE_COOLDOWN_MINUTES=5
AGENT_POOL_ACQUIRE_TIMEOUT_SECONDS=30
